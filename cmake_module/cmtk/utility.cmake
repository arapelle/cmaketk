
macro(cmtk_fatal_ifdef msg)
  foreach(var IN ITEMS ${ARGN})
    if(DEFINED ${var})
      message(FATAL_ERROR "${msg}")
    endif()
  endforeach()
endmacro()

macro(cmtk_fatal_ifndef msg)
  foreach(var IN ITEMS ${ARGN})
    if(NOT DEFINED ${var})
      message(FATAL_ERROR "${msg}")
    endif()
  endforeach()
endmacro()

function(cmtk_fatal_if_none_is_def msg)
  foreach(var IN ITEMS ${ARGN})
    if(DEFINED ${var})
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "${msg}")
endfunction()

function(cmtk_fatal_if_none_is_true msg)
  foreach(var IN ITEMS ${ARGN})
    if(DEFINED ${var} AND ${${var}})
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "${msg}")
endfunction()

function(cmtk_fatal_if_none_of var_name)
  if(NOT DEFINED "${var_name}")
      message(FATAL_ERROR "Variable ${var_name} is not defined.")
  endif()
  set(expected_values ${ARGN})
  list(FIND expected_values "${${var_name}}" index)
  if(index EQUAL -1)
      message(FATAL_ERROR "${var_name} has an unexpected value: ${${var_name}}. (expected: ${ARGN})")
  endif()
endfunction()


macro(cmtk_set_ifndef var_name value)
  if(NOT DEFINED ${var_name})
    set(${var_name} ${value})
  endif()
endmacro()

macro(cmtk_set_iftest var)
  set(lists "IF;THEN;ELSE")
  cmake_parse_arguments("ARG" "" "" "${lists}" ${ARGN})
  cmtk_fatal_ifndef("IF is required and contains the test expression." ARG_IF)
  cmtk_fatal_ifndef("THEN is required and contains the value if the test expression is valid" ARG_THEN)
  if(${ARG_IF})
    set(${var} ${ARG_THEN})
  elseif(DEFINED ARG_ELSE)
    set(${var} ${ARG_ELSE})
  endif()
endmacro()

function(cmtk_list_nth_or_default list_var index default_value out_var)
    list(LENGTH ${list_var} list_size)
    if(index LESS list_size)
        list(GET ${list_var} ${index} value)
        set(${out_var} ${value} PARENT_SCOPE)
    else()
        set(${out_var} ${default_value} PARENT_SCOPE)
    endif()
endfunction()


macro(cmtk_make_lower_c_identifier str return_var)
  string(MAKE_C_IDENTIFIER ${str} ${return_var})
  string(TOLOWER ${${return_var}} ${return_var})
endmacro()

macro(cmtk_make_upper_c_identifier str return_var)
  string(MAKE_C_IDENTIFIER ${str} ${return_var})
  string(TOUPPER ${${return_var}} ${return_var})
endmacro()


function(cmtk_assert)
    if(${ARGN})
    else()
        string(JOIN " " assert_msg ${ARGN})
        message(FATAL_ERROR "ERROR: Assertion failed: ${assert_msg}")
    endif()
endfunction()
